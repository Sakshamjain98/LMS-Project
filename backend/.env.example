# Runtime
NODE_ENV=development
PORT=4040

# Core Security
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,https://psclasses.in,https://www.psclasses.in
TRUST_PROXY=false
ENABLE_SWAGGER=true
REQUEST_SIZE_LIMIT=10mb

# Database / Cache
MONGO_URI=mongodb://localhost:27017/lms
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_MAX_POOL_SIZE=20
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Auth / OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# OTP / Email
OTP_EXPIRY_MINUTES=10
RESEND_API_KEY=re_JhpuKmnf_NRecdLdbT3CevAJ5DERxQQ5V
EMAIL_FROM="PS Classes <noreply@psclasses.in>"
FRONTEND_URL=https://psclasses.in
BRAND_SITE_URL=https://psclasses.in
EMAIL_LOGO_URL=https://www.psclasses.in/assets/logo-DHy9Va5o.png

# Media / Payment
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
PAYMENT_MODE=DEV
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook signing secret from Razorpay dashboard (Settings → Webhooks).
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
