# --- Frontend env (Vite reads everything VITE_* at build time) ---

# Public URL of the deployed backend (Railway / wherever it lives).
# In docker-compose / behind a reverse-proxy you can set this to "/api"
# and proxy externally; on Railway each service has its own URL so use the
# absolute one here.
VITE_API_BASE_URL=https://your-backend.up.railway.app

# Google OAuth client ID used by the login page.
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# --- Runtime (consumed by the nginx container, not the React bundle) ---

# Railway injects $PORT automatically; setting a value here is only useful
# for local `docker run` testing.
PORT=8080
